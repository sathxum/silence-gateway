# Silence Gateway — local Supabase API gateway (replaces Kong/Envoy).
#
# Serves exactly these prefixes and nothing else:
#   /auth/v1/*  ->  silence-auth:9999/*     (GoTrue)
#   /rest/v1/*  ->  silence-rest:3000/*     (PostgREST)
#   /           ->  silence-app:3000/*      (Silence Gateway app, TanStack SSR)
# Every other backend surface is denied with 403, so Studio / postgres-meta /
# storage / realtime / edge-functions simply do not exist here.
#
# This file is an nginx TEMPLATE: the official image runs envsubst over
# /etc/nginx/templates/*.template at startup, replacing ${ANON_KEY} and
# ${SERVICE_ROLE_KEY} from the container environment, and writes the result to
# /etc/nginx/conf.d/default.conf.

# The api keys are ~170-200 character JWTs, so the default 64-byte hash bucket
# is too small and nginx refuses to start ("could not build map_hash").
map_hash_bucket_size 512;
map_hash_max_size 2048;

map $http_apikey $apikey_ok {
    default                    0;
    "${ANON_KEY}"              1;
    "${SERVICE_ROLE_KEY}"      1;
}

server {
    listen 8000;
    server_name _;

    # Do not leak the version, and cap request sizes.
    server_tokens off;
    client_max_body_size 100m;

    # Upstreams are resolved at REQUEST time via Docker's embedded DNS, NOT at
    # config load. Why: on a fresh install api-gw starts BEFORE the app
    # container exists (the installer creates silence-app in a later step), and
    # after a reboot container start order is not guaranteed. A static
    # proxy_pass makes nginx refuse to start with:
    #   "host not found in upstream" — a runtime resolver avoids that entirely.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # CORS — the dashboard is served from the same origin, but allow any origin
    # so the API is usable from other clients exactly like hosted Supabase.
    add_header Access-Control-Allow-Origin  $http_origin always;
    add_header Access-Control-Allow-Headers "authorization, x-client-info, apikey, content-type, x-supabase-api-version, range, accept, accept-profile, content-profile, prefer, x-request-id, x-user-agent" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD" always;
    add_header Access-Control-Expose-Headers "content-range, range, content-length, content-type, x-supabase-api-version" always;
    add_header Access-Control-Max-Age 3600 always;

    location = /health {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location /auth/v1/ {
        if ($apikey_ok = 0) { return 403; }
        if ($request_method = OPTIONS) { return 204; }
        # NOTE: `set` MUST come before `rewrite ... break` — break stops ALL
        # rewrite-module directives (set included), so a set after it would
        # never run and proxy_pass would get an empty URL (HTTP 500).
        set $auth_upstream http://silence-auth:9999;
        rewrite ^/auth/v1/(.*)$ /$1 break;
        proxy_pass $auth_upstream$uri$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 60s;
    }

    location /rest/v1/ {
        if ($apikey_ok = 0) { return 403; }
        if ($request_method = OPTIONS) { return 204; }
        set $rest_upstream http://silence-rest:3000;
        rewrite ^/rest/v1/(.*)$ /$1 break;
        proxy_pass $rest_upstream$uri$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 120s;
    }

    # Silence Gateway app (TanStack Start SSR) incl. /v1/* gateway + /api/* + UI.
    # Variable upstream = resolved per-request: nginx boots even when the app
    # container does not exist yet (fresh install) and picks it up the moment
    # it appears — no restart needed.
    location / {
        set $app_upstream http://silence-app:3000;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
