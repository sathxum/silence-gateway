# Silence API — required environment variables
# Copy to .env and fill with real values. NEVER commit .env.

# Supabase-compatible backend (self-hosted stack)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side encryption key for provider secrets (32 bytes, hex)
PROVIDER_ENC_KEY=

# Bootstrap admin (used once on first deploy)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
